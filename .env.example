# Copy this file to .env and set a real password before running the server.
# Protects the /roster page and its editing endpoint — NOT the game-data
# ingestion endpoint, which every player's watcher needs to reach unattended.
ROSTER_USERNAME=admin
ROSTER_PASSWORD=changeme

# Which SQLite file this deployment reads/writes. Point mock testing, the
# beta, and the real launch at different files so their data never mixes —
# e.g. DB_FILE=beta.db during the beta, DB_FILE=live.db on launch night.
# Defaults to lan_progression.db if unset.
DB_FILE=lan_progression.db

# Minutes without any event from a character before the dashboard hides it as
# stale (e.g. a bank alt someone logged into and left parked). Defaults to 60.
# Delivery is reload-gated (the addon's sync), so a player who's actively
# playing but hasn't synced within this window also drops off until their next
# sync — raise it if that hides people who are really playing.
# STALE_AFTER_MINUTES=60

# Optional. Locks the watcher download on the /setup page behind a passphrase
# you hand out (e.g. over Discord). When set, the bare .exe is no longer served;
# friends enter the passphrase on the page and get a zip containing the .exe
# plus a ready-made config with the server address and INGESTION_TOKEN filled
# in, so they never see or type the token. Use a real passphrase (several random
# words) — wrong guesses are rate-limited but a weak one is still guessable.
# Leave unset for a LAN deployment: the .exe stays a plain public download.
# DOWNLOAD_PASSPHRASE=correct horse battery staple

# Optional. The address friends reach the site at, written into the bundled
# config, e.g. https://4l.noftz.net. Without it the address is taken from the
# request (fine behind Coolify's proxy, which forwards the host and scheme).
# PUBLIC_URL=https://4l.noftz.net

# Optional. Protects /api/log-update (the game-data ingestion endpoint) with
# a shared secret every watcher must send via the X-Ingestion-Token header.
# Leave unset for a trusted-LAN-only deployment — the endpoint stays open,
# exactly as before. Set this (same value here and on every watcher) before
# the server is reachable from the internet, e.g. once it's hosted on
# Coolify — otherwise anyone who finds the URL can inject fake data.
# INGESTION_TOKEN=changeme
