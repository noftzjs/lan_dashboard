{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && .venv/Scripts/python.exe .claude/hooks/lint_after_edit.py",
            "timeout": 30,
            "statusMessage": "Linting the edited file"
          }
        ]
      }
    ]
  }
}
